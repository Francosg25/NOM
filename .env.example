# Desarrollo local exclusivamente. Copiar a .env en la raíz; nunca guardar secretos en Git.
ENVIRONMENT=development
AUTH_MODE=portal
DEV_AUTH_ENABLED=true
DEV_DEFAULT_ROLE=administrador
DATABASE_URL=sqlite:///./data/nom.db
STORAGE_BACKEND=local
STORAGE_PATH=./data/evidence
DEMO_MODE=false
FRONTEND_DIST=../frontend/dist
MONITOR_ENABLED=true
SCHEDULER_ENABLED=true
SOURCE_DNS_MODE=local

# App Service: startup.sh usa SQLite y archivos bajo /home/nom-monitor.
# No se necesitan Entra, PostgreSQL ni Blob para consultar el boletín.
# Servicios opcionales, solo si se decide usarlos después:
# AUTH_MODE=entra
# DATABASE_URL=postgresql+psycopg://USUARIO:VALOR_SEGURO@HOST:5432/BASE?sslmode=verify-full
# STORAGE_BACKEND=azure
# AZURE_STORAGE_ACCOUNT_URL=https://CUENTA.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=nom-evidence
# ENTRA_TENANT_ID=
# ENTRA_AUDIENCE=
# ENTRA_CLIENT_ID=
# ENTRA_SCOPES=api://ID_DE_API/access_as_user
# ENTRA_APP_SERVICE_AUTH=false
# Se usan certificados del sistema + autoridades públicas, manteniendo HTTPS verificado.
# SSL_CERT_FILE / SSL_CERT_DIR existentes tienen prioridad; no se deben desactivar verificaciones.
# Si un proxy HTTPS ya configurado en el entorno o Windows resuelve DNS:
# SOURCE_DNS_MODE=proxy
# Identidad administrada preferida para Blob; sin claves de cuenta en código.
